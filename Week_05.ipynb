   "source": [
    "def f4(x, y):\n",
    "    return x**2 + 2*y**2 - 6*x + 4*y + 18\n",
    "\n",
    "xx = np.linspace(-10, 10, 500)\n",
    "yy = np.linspace(-10, 10, 500)\n",
    "X, Y = np.meshgrid(xx, yy)\n",
    "Z = f4(X, Y)\n",
    "\n",
    "plt.figure(figsize=(7, 6))\n",
    "contours = plt.contour(X, Y, Z, levels=15)\n",
    "plt.clabel(contours, inline=True, fontsize=8)\n",
    "plt.scatter([3], [-1], marker=\"x\", s=80, label=\"Center / minimum (3,-1)\")\n",
    "plt.xlabel(\"x\")\n",
    "plt.ylabel(\"y\")\n",
    "plt.title(\"Question 4(a): Level curves\")\n",
    "plt.xlim(-10, 10)\n",
    "plt.ylim(-10, 10)\n",
    "plt.grid(True)\n",
    "plt.legend()\n",
    "plt.show()"
   ]
