   "source": [
    "# Question 12 — Union and Conditional Probability\n",
    "\n",
    "Given\n",
    "\n",
    "$$\n",
    "P(A)=0.7,\n",
    "$$\n",
    "\n",
    "$$\n",
    "P(B)=0.5,\n",
    "$$\n",
    "\n",
    "and\n",
    "\n",
    "$$\n",
    "P((A\\cup B)^c)=0.1.\n",
    "$$\n",
    "\n",
    "Therefore,\n",
    "\n",
    "$$\n",
    "P(A\\cup B)=0.9.\n",
    "$$\n",
    "\n",
    "Using\n",
    "\n",
    "$$\n",
    "P(A\\cup B)\n",
    "=\n",
    "P(A)+P(B)-P(A\\cap B),\n",
    "$$\n",
    "\n",
    "we get\n",
    "\n",
    "$$\n",
    "0.9\n",
    "=\n",
    "0.7+0.5-P(A\\cap B).\n",
    "$$\n",
    "\n",
    "Thus,\n",
    "\n",
    "$$\n",
    "\\boxed{\n",
    "P(A\\cap B)=0.3.\n",
    "}\n",
    "$$\n",
    "\n",
    "## 12(b)\n",
    "\n",
    "$$\n",
    "P(A\\mid B)\n",
    "=\n",
    "\\frac{P(A\\cap B)}{P(B)}\n",
    "=\n",
    "\\frac{0.3}{0.5}.\n",
    "$$\n",
    "\n",
    "So,\n",
    "\n",
    "$$\n",
    "\\boxed{\n",
    "P(A\\mid B)=0.6.\n",
    "}\n",
    "$$\n",
    "\n",
    "## 12(c)\n",
    "\n",
    "$$\n",
    "P(B\\mid A)\n",
    "=\n",
    "\\frac{P(A\\cap B)}{P(A)}\n",
    "=\n",
    "\\frac{0.3}{0.7}.\n",
    "$$\n",
    "\n",
    "Therefore,\n",
    "\n",
    "$$\n",
    "\\boxed{\n",
    "P(B\\mid A)=\\frac37\\approx0.428571.\n",
    "}\n",
    "$$"
   ]
